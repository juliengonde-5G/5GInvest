# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Flask
SECRET_KEY=CHANGE_ME_RANDOM_STRING
FLASK_ENV=production

# APIs
CLAUDE_API_KEY=sk-ant-api03-xxx
ALPHA_VANTAGE_KEY=YOUR_KEY_HERE


# Powens (ex-Budget Insight) - Agrégation bancaire
# Sandbox gratuit: https://powens.com/developers/
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_SANDBOX=true

# OAuth Google (optionnel, mode solo si vide)
# Créer: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain (for nginx)
DOMAIN=dashboard.5ginvest.fr
